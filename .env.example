# Copy to .env and keep it out of Git.
POSTGRES_DB=evidenceos
POSTGRES_USER=evidenceos
POSTGRES_PASSWORD=local-only-change-me
EVIDENCEOS_APP_ENV=development
# Default local workflow stays unprotected. Protected mode is single-operator only.
# To enable protection: set service_token and generate strong independent secrets.
# Production refuses to start without service_token mode and a >=32-character API token.
EVIDENCEOS_SECURITY_MODE=local
EVIDENCEOS_API_SERVICE_TOKEN=
# API-only OIDC resource-server verification (not yet a web login).
# Set EVIDENCEOS_SECURITY_MODE=oidc and configure a trusted HTTPS issuer,
# API-specific audience, and a fixed trusted signing-key endpoint.
# The bundled Next.js UI deliberately returns 503 in OIDC mode until a
# secure browser PKCE/session implementation is developed.
EVIDENCEOS_OIDC_ISSUER=
EVIDENCEOS_OIDC_AUDIENCE=
EVIDENCEOS_OIDC_JWKS_URL=
EVIDENCEOS_WEB_USERNAME=
# Protected web mode also needs a >=20-character Basic Auth password.
EVIDENCEOS_WEB_PASSWORD=
EVIDENCEOS_API_HOST_PORT=8001
# Frontend runs on 3001 on the host; its container uses 3000.
EVIDENCEOS_WEB_HOST_PORT=3001
EVIDENCEOS_DATABASE_URL=postgresql+asyncpg://evidenceos:local-only-change-me@localhost:5432/evidenceos
EVIDENCEOS_CORS_ORIGINS=[]
# Obtain at https://openalex.org/settings/api; never commit the real key.
EVIDENCEOS_OPENALEX_API_KEY=
EVIDENCEOS_CROSSREF_CONTACT_EMAIL=
EVIDENCEOS_RESEARCH_TIMEOUT_SECONDS=8

# Optional external AI evaluation. Submitting passages sends them to Groq.
EVIDENCEOS_GROQ_API_KEY=
EVIDENCEOS_GROQ_MODEL=openai/gpt-oss-20b
