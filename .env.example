# Copy to .env and keep it out of Git.
POSTGRES_DB=evidenceos
POSTGRES_USER=evidenceos
POSTGRES_PASSWORD=local-only-change-me
EVIDENCEOS_APP_ENV=development
# Default local workflow stays unprotected. Protected mode is single-operator only.
# To enable protection: set service_token and generate strong independent secrets.
# Production refuses to start without service_token mode and a >=32-character API token.
EVIDENCEOS_SECURITY_MODE=local
EVIDENCEOS_API_SERVICE_TOKEN=
# OIDC resource-server + confidential Next.js PKCE login requires trusted
# issuer, API-specific audience, fixed JWKS URL, and web client credentials.
EVIDENCEOS_OIDC_ISSUER=
EVIDENCEOS_OIDC_AUDIENCE=
EVIDENCEOS_OIDC_JWKS_URL=
# OIDC web BFF — configure the IdP as a confidential Authorization Code client
# with PKCE S256, and register the exact URI WEB_ORIGIN/auth/callback.
# The web client ID is different from the API's OIDC audience.
EVIDENCEOS_OIDC_WEB_CLIENT_ID=
# Strong secret from your OIDC provider (server-side only, never commit).
EVIDENCEOS_OIDC_WEB_CLIENT_SECRET=
# 32 random bytes encoded as unpadded base64url. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EVIDENCEOS_WEB_SESSION_KEY=
# OIDC requires a shared Redis session allowlist for logout/revocation.
# In Compose this address resolves on the *internal* bridge network, no public port.
# Production OIDC requires an externally managed rediss:// TLS endpoint.
EVIDENCEOS_SESSION_REDIS_URL=redis://redis:6379
# Set an independently generated 32+ character secret, never commit real values.
# OIDC mode refuses to start login if this is missing or too short.
EVIDENCEOS_SESSION_REDIS_PASSWORD=
# Local HTTP is permitted only for localhost/127.0.0.1 in non-production mode.
# Public production deployments require an HTTPS origin and additional hardening.
EVIDENCEOS_WEB_ORIGIN=http://127.0.0.1:3001
EVIDENCEOS_WEB_USERNAME=
# Protected web mode also needs a >=20-character Basic Auth password.
EVIDENCEOS_WEB_PASSWORD=
EVIDENCEOS_API_HOST_PORT=8001
# Frontend runs on 3001 on the host; its container uses 3000.
EVIDENCEOS_WEB_HOST_PORT=3001
EVIDENCEOS_DATABASE_URL=postgresql+asyncpg://evidenceos:local-only-change-me@localhost:5432/evidenceos
EVIDENCEOS_CORS_ORIGINS=[]
# API-side distributed rate limiter. Production requires enabled=true and a
# trusted rediss:// endpoint with its own strong Redis credential.
# Local development and isolated Keycloak staging keep this disabled.
# With enabled=true: authenticated API callers share a 120/minute budget,
# and expensive research operations share a further 12/minute budget.
EVIDENCEOS_RATE_LIMIT_ENABLED=false
EVIDENCEOS_RATE_LIMIT_REDIS_URL=
EVIDENCEOS_RATE_LIMIT_REDIS_PASSWORD=
EVIDENCEOS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
EVIDENCEOS_RATE_LIMIT_EXPENSIVE_PER_MINUTE=12
# Obtain at https://openalex.org/settings/api; never commit the real key.
EVIDENCEOS_OPENALEX_API_KEY=
EVIDENCEOS_CROSSREF_CONTACT_EMAIL=
EVIDENCEOS_RESEARCH_TIMEOUT_SECONDS=8

# Optional external AI evaluation. Submitting passages sends them to Groq.
EVIDENCEOS_GROQ_API_KEY=
EVIDENCEOS_GROQ_MODEL=openai/gpt-oss-20b
